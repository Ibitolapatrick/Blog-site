    <h1 class="title">Welcome to YourBlog!</h1>
    <p>This is a safe space for you where you can express yourself withouth guilt and release anything that has been bothering you.</p>
    <!-- <h3>locals.posts[0].posttitle</h3> -->
    <main class="form-signin w-100 m-auto"> 
        <form action="/submit" method="post">
            <h1 class="h3 mb-3 fw-normal">Write your first post:</h1>
            <div class="form-floating"> <input type="text" name="title-post" class="form-control" id="floatingInput"
                    placeholder="Title"> <label for="floatingInput">Title</label> </div>
            <div class="form-floating"> <input type="text" name="personPost" class="form-control" id="floatingPassword"
                    placeholder="Post"> <label for="floatingPassword">Post</label> </div>
            <button class="btn btn-primary w-100 py-2" type="submit">Post it!</button>
        </form>
    </main>


