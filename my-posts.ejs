<%- include("partials/header.ejs") %>

    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Document</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="/styles/main.css">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&display=swap" rel="stylesheet">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Dongle&display=swap" rel="stylesheet">
    </head>

    <body>

        <%if (posts.length===0){%>
            <p>No post yet</p>
            <%}else{%>
                <h1>Your posts!</h1>
                <%for (let i=0;i<posts.length;i++){%>
                    <h3 class="title">
                        <%=posts[i].postTitle%>
                    </h3>
                    <p>
                        <%=posts[i].actualPost%>
                    </p>
                    <div>
                    <form action="/delete-posts" method="post">
                        <button type="submit" class="btn btn-danger rounded-pill px-3" type="button">Delete</button>
                        <input type="hidden" name="indexToDelete" value="<%=i%>">
                    </form>
                    <form action="/update-post" method="post">
                        <button type="submit" class="btn btn-info rounded-pill px-3" type="button">Update</button>
                        <input type="hidden" name="indexToUpdate" value="<%=i%>">
                    </form>
                    </div>
                    
                    <%} }%>



    </body>

    </html>
<%- include("partials/footer.ejs") %>